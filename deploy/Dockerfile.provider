# provider-mock: fake game provider
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -trimpath -o /out/provider-mock ./cmd/provider-mock

FROM alpine:3.20
COPY --from=build /out/provider-mock /usr/local/bin/provider-mock
EXPOSE 8082
ENTRYPOINT ["provider-mock"]
